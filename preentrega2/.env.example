# Copiá este archivo como .env y completá la key del proveedor que vas a usar.

# Proveedor a usar: openai o anthropic
LLM_PROVIDER=openai

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Opcionales: si quedan vacías se usan gpt-4o-mini y claude-opus-5-5
OPENAI_MODEL=
ANTHROPIC_MODEL=
# Opcional: tope de tokens de la respuesta (por defecto 1000). Un valor muy bajo, como 50,
# fuerza respuestas cortadas para probar la detección del finish_reason.
LLM_MAX_TOKENS=
